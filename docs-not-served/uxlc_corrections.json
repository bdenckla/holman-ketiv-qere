    {
      "case_number": 9,
      "ref": "Deuter 33:28.13",
      "book": "Deuter",
      "book_display": "Deuteronomy",
      "chapter": 33,
      "verse": 28,
      "atom": 13,
      "email_key": "proposed-correction-and-note-for-uxlc-deuteronomy-33",
      "index_in_email": 1,
      "heading": "Deuteronomy 33:28",
      "suggestion_kind": "Change the text or add a note",
      "fields": [
        {
          "label": "Word/Verse",
          "value": "Deut 33:28.13 UXLC (יַֽעַרְפוּ / יַ֥עַרְפוּ)"
        },
        {
          "label": "Manuscript Image",
          "value": "238_Deu_32.52b-33.29 / Col. 3 bottom"
        },
        {
          "label": "Suggested Correction",
          "value": "Change Meteg to Mercha OR include an apparatus note detailing the manuscript variants."
        },
        {
          "label": "Critical Note",
          "value": "Dotan features a Mercha. In Daat Miqra, Breuer reads both Aleppo (A) and Leningrad (L) as having a Mercha. Conversely, Sassoon 1053 and Jacob ben Chayyim print a Meteg, but crucially include a Maqqef to bind the word to the subsequent Silluq. If the Meteg tradition is maintained, an editorial note should indicate that alternate manuscripts require a Maqqef; an independent word cannot sit accentless directly preceding a Silluq without violating Tiberian accentuation syntax."
        }
      ],
      "manuscript_folio": "119B",
      "images": [
        {
          "attachment": "Deut 33.28.13.png",
          "caption": "Deut 33.28.13",
          "file": "deut_33_28_13.png"
        },
        {
          "attachment": "Bomberg edition by ben Chayyim.png",
          "caption": "Bomberg edition by ben Chayyim",
